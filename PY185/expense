#!/usr/bin/env python
import psycopg2
from psycopg2 import extras
from sys import argv
from textwrap import dedent

# IF no arg
def display_help():
    prompt = """
    An expense recording system

    Commands:

    add AMOUNT MEMO [DATE] - record a new expense
    clear - delete all expenses
    list - list all expenses
    delete NUMBER - remove expense with id NUMBER
    search QUERY - list expenses with a matching memo field
    """

    print(dedent(prompt))


def format_memo(memo):
    if len(memo) > 10:
        memo_list = memo.split()
        line = ''
        new_memo = ""
        for word in memo_list:
            if len(line + " " + word) <= 10:
                line += f'{word} ' 
                new_memo += ' ' + word
            else:
                new_memo = new_memo.center(11)+ ' |\n    |          | '
                new_memo += word.center(11) # TODO dont center if going to building new 
                line = word 
        return new_memo
    return memo

def list_expenses():
    connection = psycopg2.connect(dbname='expense')
    try:
        with connection:
            with connection.cursor(cursor_factory=extras.DictCursor) as cursor:
                cursor.execute('SELECT * FROM expenses ORDER BY created_on;')
                expenses = cursor.fetchall()

    finally:
        connection.close()
    
    if expenses == []:
        print('No expenses to see yet ...')
        return
        

    total_amount = 0
    results = []
    for expense in expenses:
        memo = format_memo(str(expense['memo']))
        columns = [
            str(expense['id']).rjust(3),
            str(expense['amount']).rjust(8),
            str(memo).center(11),
            str(expense['created_on'])
        ]
        total_amount += expense['amount']
        results.append(" | ".join(columns))

    expense_count = len(expenses)
    if expense_count == 1:
       expense_description = "There is 1 expense. \n"
    else:
        expense_description = f"There are {expense_count} expenses. \n"


    print(expense_description)
    print(' id |  amount  |    memo     | created_on'
        '\n----+----------+-------------+------------')
    print('\n'.join(results))
    print("\n------------------------------------------")
    print(f"\nTotal {str(total_amount).rjust(35)}")


def add(amount, memo):
    connection = psycopg2.connect(dbname='expense')
    try:
        with connection:
            with connection.cursor(cursor_factory=extras.DictCursor) as cursor:
                cursor.execute(f'''INSERT INTO expenses (amount, memo, created_on)
                VALUES ({float(amount)}, '{memo}', NOW());''')

    finally:
        connection.close()


def clear():
    connection = psycopg2.connect(dbname='expense')
    try:
        with connection:
            with connection.cursor(cursor_factory=extras.DictCursor) as cursor:
                cursor.execute('DELETE FROM expenses;')

    finally:
        connection.close()

    print('All expenses have been deleted')


def delete(number):
    connection = psycopg2.connect(dbname='expense')
    try:
        with connection:
            with connection.cursor(cursor_factory=extras.DictCursor) as cursor:
                cursor.execute(f'SELECT * FROM expenses WHERE id = {int(number)};')
                expense = cursor.fetchall()

                cursor.execute(f'DELETE FROM expenses WHERE id = {int(number)};')
                
    finally:
        connection.close()

    for row in expense:
        columns = [
            str(row['id']).rjust(3),
            str(row['created_on']),
            str(row['amount']).rjust(12),
            str(row['memo'])
        ]

    print(f"""The following expense has been deleted:\n {" | ".join(columns)}""")
    

def search(query):
    connection = psycopg2.connect(dbname='expense')
    try:
        with connection:
            with connection.cursor(cursor_factory=extras.DictCursor) as cursor:
                cursor.execute(f"SELECT * FROM expenses WHERE memo LIKE '%{query}%';")
                expenses = cursor.fetchall()

    finally: 
        connection.close()

    result_total = len(expenses)

    results = []
    for expense in expenses:
        columns = [
            str(expense['id']).rjust(3),
            str(expense['created_on']),
            str(expense['amount']).rjust(12),
            str(expense['memo'])
        ]
        results.append("| ".join(columns))

    if result_total == 1:
        description = 'There is 1 expense.'
    else:
        description = f'There are {result_total} expenses.'

    print(f"""{description} \n{'\n'.join(results)}""") 


def reset_rows():
    connection = psycopg2.connect(dbname='expense')
    try:
        with connection:
            with connection.cursor(cursor_factory=extras.DictCursor) as cursor:
                cursor.execute('''INSERT INTO expenses
                (amount, memo, created_on) VALUES
                (5.99, 'coffee', NOW() ),
                (123.45, 'subscription', NOW()),
                (67, 'your mom', NOW());'''
                )

    finally: 
        connection.close()

def fix_apostrophe_memo(memo):
    new_memo = ""
    for char in memo:
        if char == "'":
            new_memo += "'"
        new_memo += char
    
    return new_memo


'''
--------------------------------
CALL COMMANDS BASED ON ARGUMENTS
--------------------------------
'''

def main():

    argument_length = len(argv)

    if argument_length == 1: # ./expense
        display_help()

    else:
        command = argv[1]
        if argument_length == 2: # ./expense [list, clear, reset]
            if command == 'list':
                list_expenses()
            if command == 'clear':
                confirm = input('This will remove all expenses.' \
                                ' Are you sure? (enter y to confirm)')
                if confirm == 'y':
                    clear()
            if command == 'reset':
                reset_rows()

        elif argument_length == 3: #./expense [delete <num>, search <memo>]
            argument = argv[2]

            if command == 'delete':
                if argument.isnumeric():
                    delete(argument)
                else:
                    print('Oops! Please enter a valid number corresponding'\
                    'to the id of the expense you are looking for.')

            if command == 'search': # <memo> needs to be in quotes to be 1 arg
                search(argument) # TODO handle bad input (arg is not a single string)


        elif argument_length == 4: # ./expense add <AMOUNT MEMO>
            if command == 'add':
                amount = argv[2]
                if not amount.isnumeric() or float(amount) < 0:
                    print('You must provide a non negative numeric' \
                    ' amount for the 2nd argument (amount).')
                    return
                memo = argv[3]
                if "'" in memo:
                    memo = fix_apostrophe_memo(memo)
                add(amount, memo) 

if __name__ == "__main__":
    main()