#!/usr/bin/env python
import psycopg2
from psycopg2 import extras
from sys import argv
from textwrap import dedent
from contextlib import contextmanager

class ExpenseData:
    def __init__(self):
        self._set_up_schema()

    @contextmanager
    def _database_connect(self):
        connection = psycopg2.connect(dbname='expense')
        try:
            with connection:
                yield connection
        finally:
            connection.close()

    def _format_expenses(self, expenses, total_expenses=False):
        total_amount = 0
        results = []
        for expense in expenses:
            columns = [
                str(expense['id']).rjust(3),
                str(expense['created_on']),
                str(expense['amount']).rjust(12),
                str(expense['memo'])
            ]
            total_amount += expense['amount']
            results.append(" | ".join(columns))

        if total_expenses:
                return results, round(total_amount, 2)
        return results
    
    def _format_results(self, expenses):
        expense_count = len(expenses)
        match expense_count:
            case 0:
                return 'There are no expenses.'
            case 1:
                expense_description = "There is 1 expense. \n"
                results = self._format_expenses(expenses)
                return f'{expense_description}{"\n".join(results)}'
            case _:
                expense_description = f"There are {expense_count} expenses. \n"
                results, total_amount = self._format_expenses(expenses, True)
                output = (f"{expense_description}{'\n'.join(results)}"
                f"\n{'-'*50}"
                f"\nTotal {str(total_amount).rjust(25)}")
                return output
            
    def _set_up_schema(self):
        with self._database_connect() as connection:
            with connection.cursor() as cursor:
                cursor.execute("""SELECT COUNT(*) FROM information_schema.tables
                                WHERE table_schema = 'public' AND 
                                table_name = 'expenses';""")
                table_exists = cursor.fetchone()

                if not table_exists[0]:
                    cursor.execute('''CREATE TABLE expenses (
                                    id serial PRIMARY KEY,
                                    amount numeric(6,2) NOT NULL CHECK (amount >= 0.01),
                                    memo text NOT NULL,
                                    created_on date NOT NULL);''')
    
    def list_expenses(self):
        with self._database_connect() as connection:
            with connection.cursor(cursor_factory=extras.DictCursor) as cursor:
                cursor.execute('SELECT * FROM expenses ORDER BY created_on;')
                expenses = cursor.fetchall()
        result = self._format_results(expenses)
        print(result)


    def add_expense(self, amount, memo):
         with self._database_connect() as connection:
            with connection.cursor(cursor_factory=extras.DictCursor) as cursor:
                cursor.execute('''INSERT INTO expenses (amount, memo, created_on)
                VALUES (%s, %s, NOW());''', (float(amount), memo, ))


    def delete_all_expenses(self):
        with self._database_connect() as connection:
            with connection.cursor(cursor_factory=extras.DictCursor) as cursor:
                cursor.execute('DELETE FROM expenses;')

                print('All expenses have been deleted')


    def delete_expense(self, number):
        with self._database_connect() as connection:
            with connection.cursor(cursor_factory=extras.DictCursor) as cursor:
                cursor.execute('SELECT * FROM expenses WHERE id = %s;', (int(number),)) 
                expense = cursor.fetchone()

                if expense == []:
                    print(f"There is no expense with id '{number}'")
                    return

                cursor.execute('DELETE FROM expenses WHERE id = %s;', (int(number),))

        columns = self._format_expenses(expense)
        print(f"""The following expense has been deleted:\n {" | ".join(columns)}""")

    def search_expenses(self, query):
        with self._database_connect() as connection:
            with connection.cursor(cursor_factory=extras.DictCursor) as cursor:
                sql_query = "SELECT * FROM expenses WHERE memo ILIKE %s;"
                cursor.execute(sql_query, (f'%{query}%',) ) 
                expenses = cursor.fetchall()

        result = self._format_results(expenses)
        print(result)


    def add_rows(self):
        with self._database_connect() as connection:
            with connection.cursor(cursor_factory=extras.DictCursor) as cursor:
                cursor.execute('''INSERT INTO expenses
                (amount, memo, created_on) VALUES
                (5.99, 'coffee', NOW() ),
                (123.45, 'subscription', NOW()),
                (67, 'your mom', NOW());'''
                )


class CLI():
    def __init__(self):
        self.expense_instance = ExpenseData()

    # IF no values in arg_list
    def display_help(self):
        prompt = """
        An expense recording system

        Commands:

        add AMOUNT MEMO [DATE] - record a new expense
        clear - delete all expenses
        list - list all expenses
        delete NUMBER - remove expense with id NUMBER
        search QUERY - list expenses with a matching memo field
        """

        print(dedent(prompt))


    def run(self, arg_list):
        argument_length = len(arg_list)

        if argument_length == 0: # ./expense
            command = None

        else:
            command = arg_list[0]

            match command: # TODO
                case 'clear':
                    confirm = input('This will remove all expenses.' \
                        ' Are you sure? (enter y to confirm)')
                    if confirm.lower() == 'y':
                        self.expense_instance.delete_all_expenses()

                case 'list':
                    self.expense_instance.list_expenses()

                case 'reset':
                    self.expense_instance.add_rows()

                case "delete":
                    if argument_length == 2: 
                        argument = arg_list[1]
                        if argument.isnumeric():
                            self.expense_instance.delete_expense(argument)
                    else:
                        print('Oops! You must provide an expense ID.')

                case "search":
                    if argument_length == 2:
                        argument = arg_list[1]
                        self.expense_instance.search_expenses(argument)
                    else:
                        print("Oops! You must provide a search query.")
                        return

                case "add":
                    if argument_length == 3:
                        amount = arg_list[1]
                        try: 
                            float(amount)
                        except ValueError: 
                            print('You must provide a numeric' \
                            ' amount for the 2nd argument (amount).')
                            return
                        if float(amount) < 0:
                            print('You must provide a non negative number.')
                            return
                        memo = arg_list[2]

                        self.expense_instance.add_expense(amount, memo)
                    else:
                        print("Oops! You must provide an amount and memo.")
                        return

                case _:
                    self.display_help()


if __name__ == "__main__":
    cli_instance = CLI()
    cli_instance.run(argv[1:])