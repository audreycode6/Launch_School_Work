#!/usr/bin/env python
import psycopg2
from psycopg2 import extras
from sys import argv
from textwrap import dedent

class ExpenseData:

    def list_expenses(self):
        connection = psycopg2.connect(dbname='expense')
        try:
            with connection:
                with connection.cursor(cursor_factory=extras.DictCursor) as cursor:
                    cursor.execute('SELECT * FROM expenses ORDER BY created_on;')
                    expenses = cursor.fetchall()

        finally:
            connection.close()
        
        if expenses == []:
            print('No expenses to see yet ...')
            return

        total_amount = 0
        results = []
        for expense in expenses:
            columns = [
                str(expense['id']).rjust(3),
                str(expense['created_on']),
                str(expense['amount']).rjust(12),
                str(expense['memo'])
            ]
            total_amount += expense['amount']
            results.append(" | ".join(columns))

        expense_count = len(expenses)
        if expense_count == 1:
            expense_description = "There is 1 expense. \n"
        else:
            expense_description = f"There are {expense_count} expenses. \n"


        print(expense_description)
        print('\n'.join(results))
        print("\n--------------------------------------------------")
        print(f"\nTotal {str(total_amount).rjust(25)}")


    def add_expense(self, amount, memo):
        connection = psycopg2.connect(dbname='expense')
        try:
            with connection:
                with connection.cursor(cursor_factory=extras.DictCursor) as cursor:
                    cursor.execute('''INSERT INTO expenses (amount, memo, created_on)
                    VALUES (%s, %s, NOW());''', (float(amount), memo, ))
        finally:
            connection.close()


    def clear(self):
        connection = psycopg2.connect(dbname='expense')
        try:
            with connection:
                with connection.cursor(cursor_factory=extras.DictCursor) as cursor:
                    cursor.execute('DELETE FROM expenses;')

                print('All expenses have been deleted')

        finally:
            connection.close()


    def delete(self, number):
        connection = psycopg2.connect(dbname='expense')
        try:
            with connection:
                with connection.cursor(cursor_factory=extras.DictCursor) as cursor:
                    cursor.execute('SELECT * FROM expenses WHERE id = %s;', (int(number),)) 
                    expense = cursor.fetchall()

                    cursor.execute('DELETE FROM expenses WHERE id = %s;', (int(number),))
                    
        finally:
            connection.close()

        for row in expense:
            columns = [
                str(row['id']).rjust(3),
                str(row['created_on']),
                str(row['amount']).rjust(12),
                str(row['memo'])
            ]

        print(f"""The following expense has been deleted:\n {" | ".join(columns)}""")
        

    def search(self, query):
        connection = psycopg2.connect(dbname='expense')
        try:
            with connection:
                with connection.cursor(cursor_factory=extras.DictCursor) as cursor:
                    cursor.execute("SELECT * FROM expenses WHERE memo LIKE %s;", (query,) ) # TODO use '% {query} %' for it to just need to have word somewhere in ...
                    expenses = cursor.fetchall()

        finally: 
            connection.close()

        result_total = len(expenses)

        results = []
        for expense in expenses:
            columns = [
                str(expense['id']).rjust(3),
                str(expense['created_on']),
                str(expense['amount']).rjust(12),
                str(expense['memo'])
            ]
            results.append(" | ".join(columns))

        if result_total == 1:
            description = 'There is 1 expense.'
        else:
            description = f'There are {result_total} expenses.'

        print(f"""{description} \n{'\n'.join(results)}""") 


    def reset_rows(self):
        connection = psycopg2.connect(dbname='expense')
        try:
            with connection:
                with connection.cursor(cursor_factory=extras.DictCursor) as cursor:
                    cursor.execute('''INSERT INTO expenses
                    (amount, memo, created_on) VALUES
                    (5.99, 'coffee', NOW() ),
                    (123.45, 'subscription', NOW()),
                    (67, 'your mom', NOW());'''
                    )

        finally: 
            connection.close()

class CLI():
    def __init__(self):
        self.expense_instance = ExpenseData()

    # IF no values in arg_list
    def display_help(self):
        prompt = """
        An expense recording system

        Commands:

        add AMOUNT MEMO [DATE] - record a new expense
        clear - delete all expenses
        list - list all expenses
        delete NUMBER - remove expense with id NUMBER
        search QUERY - list expenses with a matching memo field
        """

        print(dedent(prompt))


    def run(self, arg_list):

        argument_length = len(arg_list)

        if argument_length == 0: # ./expense
            command = None

        else:
            command = arg_list[0]

            match command: # TODO
                case 'clear':
                    confirm = input('This will remove all expenses.' \
                                    ' Are you sure? (enter y to confirm)')
                    if confirm == 'y':
                        self.expense_instance.clear()

                case 'list':
                    self.expense_instance.list_expenses()

                case 'reset':
                    self.expense_instance.reset_rows()

                case "delete":
                    if argument_length == 2: 
                        argument = arg_list[1]
                        if argument.isnumeric():
                            self.expense_instance.delete(argument)
                    else:
                        print('Oops! Please enter a valid number corresponding'\
                        'to the id of the expense you are looking for.')

                case "search":
                    if argument_length == 2:
                        argument = arg_list[1]
                        self.expense_instance.search(argument)
                    else:
                        print("Oops! You must provide a memo.")
                        return

                case "add":
                    if argument_length == 3:
                        amount = arg_list[1]
                        try: 
                            float(amount)
                        except ValueError: 
                            print('You must provide a numeric' \
                            ' amount for the 2nd argument (amount).')
                            return
                        if float(amount) < 0:
                            print('You must provide a non negative number.')
                            return
                        memo = arg_list[2]

                        self.expense_instance.add_expense(amount, memo)
                    else:
                        print("Oops! You must provide an amount and memo.")
                        return

                case _:
                    self.display_help()


if __name__ == "__main__":
    cli_instance = CLI()
    cli_instance.run(argv[1:])